# Variables PÚBLICAS de la web. Este archivo SÍ se sube al repositorio.
# Nunca poner aquí contraseñas, tokens ni llaves.
# Las variables definidas en Cloudflare Pages tienen prioridad sobre este archivo.
# Para pruebas locales sin subir nada, usar .env.local (ignorado por Git).

# Número de WhatsApp del negocio, formato 57XXXXXXXXXX (sin +, sin espacios).
VITE_WHATSAPP_NUMERO=573218115143

# URL /exec del Apps Script. Vacío = modo WhatsApp (MVP).
VITE_APPS_SCRIPT_URL=
